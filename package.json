{
  "name": "flowsh",
  "version": "1.0.0",
  "description": "The jq of Workflows - Simple YAML workflow to shell script compiler",
  "type": "module",
  "main": "dist/cli/index.js",
  "bin": {
    "flowsh": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts"
  },
  "keywords": [
    "workflow",
    "shell",
    "compiler",
    "jq",
    "unix",
    "bash",
    "ai",
    "agent",
    "orchestration",
    "yaml",
    "typescript",
    "cli"
  ],
  "author": "flowsh team",
  "license": "MIT",
  "dependencies": {
    "@types/dagre": "^0.7.53",
    "@types/figlet": "^1.7.0",
    "@types/inquirer": "^9.0.9",
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "cli-progress": "^3.12.0",
    "commander": "^11.1.0",
    "cosmiconfig": "^9.0.0",
    "dagre": "^0.8.5",
    "figlet": "^1.9.4",
    "gradient-string": "^3.0.0",
    "inquirer": "^13.1.0",
    "joi": "^18.0.2",
    "js-yaml": "^4.1.0",
    "jsep": "^1.4.0",
    "lodash-es": "^4.17.22",
    "mathjs": "^15.1.0",
    "neverthrow": "^8.2.0",
    "ora": "^8.2.0",
    "pino": "^10.1.0",
    "uuid": "^13.0.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash-es": "^4.17.12",
    "@types/mathjs": "^9.4.1",
    "@types/node": "^20.10.5",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "@vitest/coverage-v8": "^4.0.16",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "prettier-plugin-sort-imports": "^1.8.9",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
